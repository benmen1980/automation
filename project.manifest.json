{
  "manifest_schema": 1,
  "project": "user-automation-platform",
  "automation_creation": {
    "source": "chatgpt_prompt",
    "admin_creates_automations": false,
    "required_flow": [
      "identify_members",
      "declare_member_credentials",
      "declare_member_tests",
      "define_member_data_contracts",
      "define_full_flow_test",
      "define_unified_logging",
      "generate_automation_package",
      "validate_package",
      "provision_isolated_resources",
      "deploy_independent_pipeline",
      "run_full_flow_verification",
      "register_automation"
    ],
    "block_if": [
      "member_missing_credentials_declaration",
      "member_missing_tests",
      "member_missing_data_contract",
      "full_flow_test_missing",
      "unified_logging_missing",
      "isolation_configuration_missing"
    ]
  },
  "member_contract": {
    "required_fields": [
      "id",
      "purpose",
      "credentials",
      "tests",
      "input_contract",
      "output_contract",
      "failure_behavior",
      "logging"
    ],
    "implementation": "automation_specific",
    "reference_implementations": false
  },
  "test_contract": {
    "member_tests_required": true,
    "full_flow_test_required": true,
    "modes": ["offline", "test", "dry_run", "live"],
    "full_flow_must_verify": [
      "input_received",
      "member_sequence",
      "data_handoffs",
      "credential_usage_boundaries",
      "success_or_failure_status",
      "side_effect_result"
    ]
  },
  "logging_contract": {
    "event_schema": "automation.log",
    "required_fields": [
      "automationId",
      "executionId",
      "memberId",
      "step",
      "status",
      "timestamp"
    ],
    "required_statuses": ["started", "running", "success", "failed"],
    "secret_redaction_required": true
  },
  "isolation": {
    "chat": {
      "admin_with_one_automation_allowed": true,
      "multiple_automations_in_one_chat": false,
      "automation_isolation_preserved": true
    },
    "code": "one_package_per_automation",
    "database": "automation_owned_database_or_schema",
    "credentials": "automation_scoped_secrets_namespace",
    "runtime": "one_lambda_or_fargate_service_per_automation",
    "queue": "one_sqs_queue_and_dlq_per_automation_when_required",
    "logs": "one_cloudwatch_log_group_per_automation",
    "iam": "automation_scoped_execution_role",
    "deployment": "one_pipeline_per_automation"
  },
  "shared_platform": {
    "database_contains": [
      "users",
      "automation_registry",
      "ownership_and_permissions",
      "credential_references",
      "generic_execution_status",
      "log_event_index",
      "deployment_status"
    ],
    "database_must_not_contain": [
      "automation_specific_business_tables",
      "automation_specific_business_columns"
    ],
    "admin_responsibilities": [
      "view_automations",
      "manage_access",
      "view_credentials_metadata",
      "view_deployment_status",
      "view_logs",
      "view_execution_failures",
      "enable_or_disable_execution"
    ]
  },
  "repository_layout": {
    "automation_package": "automations/<automation-id>_<slug>/",
    "automation_runtime": "integrations/<automation-slug>/",
    "automation_database": "automations/<automation-id>_<slug>/database/",
    "automation_tests": "automations/<automation-id>_<slug>/tests/",
    "automation_deployment": "infra/aws/integrations/<automation-slug>/",
    "shared_runtime": "packages/shared/",
    "platform_runtime": "apps/api/ and src/",
    "platform_ui": "frontend/dashboard/"
  },
  "provisioning": {
    "owner": "chatgpt_project",
    "must_be_repeatable": true,
    "must_record_resource_references": true,
    "must_verify_before_registration": true,
    "database_migration_owner": "automation_package"
  },
  "git_workflow": {
    "repository_count": 1,
    "canonical_remote": "origin",
    "branch_count": 1,
    "branch": "master",
    "local_development": "localhost",
    "promotion": "push_to_master_triggers_staging_pipeline",
    "pull_branch": "master",
    "push_branch": "master",
    "feature_branches_allowed": false,
    "direct_staging_changes_allowed": false
  },
  "versioning": {
    "required_for_every_change": true,
    "must_be_bumped_before_commit_or_deployment": true,
    "version_ownership": {
      "admin": {
        "scope": "platform_admin",
        "version_location": "package.json",
        "isolated_from_automations": true,
        "bump_on_any_admin_change": true
      },
      "automation": {
        "scope": "automation",
        "version_location": "automation_manifest_and_runtime_package",
        "isolated_per_automation": true,
        "bump_only_changed_automation": true
      }
    },
    "scope_rules": {
      "platform_admin": "any Admin/platform change bumps the Admin version only",
      "automation": "any change to one automation bumps that automation's version only"
    },
    "validation": {
      "reject_missing_bump": true,
      "reject_unrelated_version_bump": true,
      "reject_cross_scope_bump": true,
      "compare_against": "previous_revision"
    }
  },
  "change_control": {
    "known_good_baseline_required": true,
    "regression_behavior_must_be_preserved": true,
    "pre_edit_checks": [
      "confirm_clean_or_documented_worktree",
      "confirm_current_branch_is_master",
      "confirm_target_scope_and_permanent_automation_id",
      "record_known_good_commit_and_deployed_versions"
    ],
    "pre_push_checks": [
      "review_exact_changed_files_and_commit_diff",
      "confirm_required_scope_version_bump",
      "confirm_commit_is_on_master",
      "confirm_remote_revision_matches_local_revision",
      "confirm_pipeline_source_branch_and_revision"
    ],
    "staging_verification": {
      "unit_tests_are_not_end_to_end_proof": true,
      "must_confirm_platform_and_automation_versions_match": true,
      "must_confirm_queue_worker_logs_database_and_external_side_effect": true,
      "do_not_report_success_when_any_status_is_stale_or_pending": true
    },
    "scope_and_safety": {
      "block_on_scope_or_identifier_ambiguity": true,
      "preserve_unrelated_worktree_changes": true,
      "never_print_or_reuse_credentials_from_chat": true,
      "request_credential_rotation_when_exposed": true
    }
  }
}
